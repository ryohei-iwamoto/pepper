# OpenAI API キー（必須）
# https://platform.openai.com/api-keys で取得
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Pepper の IP アドレス（省略時 192.168.0.46）
PEPPER_IP=192.168.0.46

# pynaoqi SDK のパス（省略時: リポジトリ直下の pynaoqi-sdk/ を使用）
# 例: PYNAOQI_SDK=C:\pynaoqi-python2.7-2.1.4.13-win32-vs2010
# PYNAOQI_SDK=
